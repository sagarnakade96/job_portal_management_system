# API base URLs — these are used by the browser, so they must be reachable from your host machine.
# Copy this file to .env before running `npm run dev` or building the Docker image.
#
# For local development (npm run dev):
VITE_JOBS_URL=http://localhost:8002
VITE_APPLICATIONS_URL=http://localhost:8001
VITE_CANDIDATES_URL=http://localhost:3000
